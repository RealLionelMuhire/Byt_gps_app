#!/usr/bin/env python3
"""
Run database migrations for BYThron GPS server.

Tracks applied migrations in a `schema_migrations` table so a migration file is
never executed twice. Every migration in this repo is idempotent (safe to re-run
— see 012_add_role_enum.sql, which was rewritten specifically so a re-run can
never wipe users.role), so the very first run against a database migrated by the
old untracked script simply re-applies everything once and records it; every
subsequent run is a no-op. Use `--mark-all-applied` if you know the DB is fully
migrated and want to skip that one re-run.

Usage:
  # When DB runs in Docker (recommended):
  docker compose exec gps_server ./migrate

  # When DB is on host (e.g. port 5432 exposed):
  ./migrate

  # Dry-run (show what would run):
  ./migrate --dry-run

  # Re-run every migration regardless of what's recorded (e.g. after fixing a
  # migration file — safe now that all migrations are idempotent):
  ./migrate --force

  # Record all current migration files as applied WITHOUT running them:
  ./migrate --mark-all-applied

Requires: psql (PostgreSQL client) in PATH
Uses: DATABASE_URL from .env or environment
"""

import os
import subprocess
import sys
from pathlib import Path

SERVER_DIR = Path(__file__).resolve().parent
os.chdir(SERVER_DIR)
MIGRATIONS_DIR = SERVER_DIR / "migrations"

DEFAULT_DATABASE_URL = "postgresql://gps_user:gps_password@localhost:5432/gps_tracking"

TRACKING_TABLE = "schema_migrations"
TRACKING_TABLE_DDL = (
    "CREATE TABLE IF NOT EXISTS schema_migrations ("
    " filename TEXT PRIMARY KEY,"
    " applied_at TIMESTAMPTZ NOT NULL DEFAULT NOW());"
)


def load_database_url() -> str:
    """Load DIRECT_URL (preferred for DDL) or DATABASE_URL from .env or environment.

    Migrations run DDL and multi-statement SQL files, which need a stable
    session — so DIRECT_URL (session-mode/direct connection) is preferred over
    DATABASE_URL when both are set (e.g. Supabase's transaction-mode pooler on
    DATABASE_URL isn't a good fit for migrations).
    """
    values = {}
    env_file = SERVER_DIR / ".env"
    if env_file.exists():
        with open(env_file) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, _, value = line.partition("=")
                    values[key.strip()] = value.strip().strip("'\"")

    return (
        values.get("DIRECT_URL")
        or os.environ.get("DIRECT_URL")
        or values.get("DATABASE_URL")
        or os.environ.get("DATABASE_URL")
        or DEFAULT_DATABASE_URL
    )


def get_migration_files():
    """Return migration files sorted by name (001, 002, ...)."""
    if not MIGRATIONS_DIR.exists():
        return []
    files = sorted(MIGRATIONS_DIR.glob("*.sql"))
    return [f for f in files if f.name.endswith(".sql")]


# ── psql helpers ─────────────────────────────────────────────────────────────

def _psql(db_url: str, args: list, timeout: int = 60) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            ["psql", db_url, "-v", "ON_ERROR_STOP=1"] + args,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except FileNotFoundError:
        print("  Error: psql not found. Install PostgreSQL client (e.g. postgresql-client).", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print(f"  Error: psql timed out after {timeout}s.", file=sys.stderr)
        sys.exit(1)


def run_sql(db_url: str, sql: str) -> None:
    """Run an inline SQL statement via psql. Exits on failure."""
    result = _psql(db_url, ["-c", sql])
    if result.returncode != 0:
        print(f"  Error running SQL: {sql[:120]!r}", file=sys.stderr)
        if result.stderr:
            print(result.stderr, file=sys.stderr)
        sys.exit(1)


def query_sql(db_url: str, sql: str) -> list:
    """Run a query and return trimmed result rows (tuples-only, unaligned)."""
    result = _psql(db_url, ["-t", "-A", "-c", sql])
    if result.returncode != 0:
        print("  Error querying database:", file=sys.stderr)
        if result.stderr:
            print(result.stderr, file=sys.stderr)
        sys.exit(1)
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


# ── Tracking helpers ─────────────────────────────────────────────────────────

def tracking_table_exists(db_url: str) -> bool:
    return query_sql(
        db_url, f"SELECT to_regclass('public.{TRACKING_TABLE}') IS NOT NULL;"
    )[0] == "t"


def get_applied(db_url: str) -> set:
    return set(query_sql(db_url, f"SELECT filename FROM {TRACKING_TABLE};"))


def record_applied(db_url: str, filename: str) -> None:
    safe = filename.replace("'", "''")
    run_sql(
        db_url,
        f"INSERT INTO {TRACKING_TABLE} (filename) VALUES ('{safe}') "
        f"ON CONFLICT (filename) DO NOTHING;",
    )


def mark_all_applied(db_url: str, migrations: list) -> None:
    run_sql(db_url, TRACKING_TABLE_DDL)
    for m in migrations:
        record_applied(db_url, m.name)


# ── Migration runner ─────────────────────────────────────────────────────────

def run_migration(db_url: str, migration_file: Path) -> bool:
    """Run a single migration file. Returns True on success."""
    result = _psql(db_url, ["-f", str(migration_file)])
    if result.returncode != 0:
        print(f"  FAILED: {migration_file.name}", file=sys.stderr)
        if result.stderr:
            print(result.stderr, file=sys.stderr)
        return False
    print(f"  OK: {migration_file.name}")
    return True


# ── Main ─────────────────────────────────────────────────────────────────────

def main():
    dry_run = "--dry-run" in sys.argv or "-n" in sys.argv
    force = "--force" in sys.argv or "-f" in sys.argv
    mark_all = "--mark-all-applied" in sys.argv

    db_url = load_database_url()
    if not db_url:
        print("Error: DATABASE_URL not set.", file=sys.stderr)
        sys.exit(1)

    migrations = get_migration_files()
    if not migrations:
        print("No migration files found in migrations/")
        sys.exit(0)

    print(f"Migrations directory: {MIGRATIONS_DIR}")

    # Read-only discovery (safe in dry-run mode too)
    table_existed = tracking_table_exists(db_url)
    applied = get_applied(db_url) if table_existed else set()

    if mark_all:
        print(
            f"Marking all {len(migrations)} migration(s) as applied "
            f"(nothing will be run)."
        )
        if not dry_run:
            mark_all_applied(db_url, migrations)
        applied = {m.name for m in migrations}

    if not table_existed and not mark_all and not dry_run:
        run_sql(db_url, TRACKING_TABLE_DDL)

    pending = [m for m in migrations if force or m.name not in applied]

    if dry_run:
        if pending:
            print("  Would run:")
            for m in pending:
                print(f"    {m.name}")
        else:
            print("  Nothing to run — all migrations already applied.")
        return

    if not pending:
        print(f"All migrations already applied ({len(applied)} recorded).")
        return

    print(f"Running {len(pending)} pending migration(s)...")
    for m in pending:
        if not run_migration(db_url, m):
            print("Stopping on failed migration — it was NOT recorded and will be retried next run.", file=sys.stderr)
            sys.exit(1)
        record_applied(db_url, m.name)

    print("Done.")


if __name__ == "__main__":
    main()
