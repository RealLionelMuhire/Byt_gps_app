# Application Settings
APP_NAME=GPS Tracking Server
APP_VERSION=1.0.0
DEBUG=False

# Server Configuration
HOST=0.0.0.0
HTTP_PORT=8000
TCP_PORT=7018

# Database — Supabase PostgreSQL
# DATABASE_URL: shared transaction-mode pooler (IPv4-only, port 6543) — used by the app at runtime
# DIRECT_URL: shared session-mode pooler (port 5432) — used for migrations (DDL needs a stable session)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Security
SECRET_KEY="your-secret-key-change-this-in-production"
CLERK_SECRET_KEY="sk_test_..."
ADMIN_SECRET="your-admin-secret"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Firebase Cloud Messaging (push notifications) — set exactly ONE of these.
# Get the key from Firebase Console > Project Settings > Service Accounts >
# Generate new private key. FIREBASE_SERVICE_ACCOUNT_JSON is preferred for
# this project's Docker deploy: docker-compose.yml only bind-mounts
# app/migrations/migrate/logs, so a key file sitting elsewhere in server/
# wouldn't be visible inside the container without also editing
# docker-compose.yml — the raw-JSON env var needs no such change.
# IMPORTANT: docker-compose's env_file does NOT strip quotes — paste the
# JSON on one line with NO surrounding quotes.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# Alternative for non-Docker/local dev: a path readable by the running process.
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-adminsdk.json

# IntouchPay (Rwanda mobile money) — credentials from intouchpay.co.rw
INTOUCH_USERNAME="your-intouchpay-username"
INTOUCH_ACCOUNT_NO="your-intouchpay-account-number"
INTOUCH_PARTNER_PASSWORD="your-intouchpay-partner-password"
INTOUCH_CALLBACK_URL="https://your-domain.com/api/webhooks/intouchpay"

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
